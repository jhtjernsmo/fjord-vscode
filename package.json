{
  "name": "fjord",
  "displayName": "Fjord",
  "description": "Your Fjord board next to your code: the task for the current branch, start branches, move tasks and open pull requests.",
  "version": "0.1.0",
  "publisher": "jhtjernsmo",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/jhtjernsmo/fjord-vscode" },
  "homepage": "https://jhtjernsmo.github.io/fjord/",
  "icon": "media/icon.png",
  "engines": { "vscode": "^1.95.0" },
  "categories": ["Other", "SCM Providers"],
  "keywords": ["kanban", "tasks", "project management", "git", "fjord"],
  "main": "./out/src/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "views": {
      "explorer": [{ "id": "fjord.board", "name": "Fjord" }]
    },
    "viewsWelcome": [
      {
        "view": "fjord.board",
        "contents": "This folder isn't linked to a Fjord project.\nLink it in Fjord (Git tab) or run `fjord git link <project> .` in a terminal.\n[Refresh](command:fjord.refresh)",
        "when": "fjord.state == unlinked"
      },
      {
        "view": "fjord.board",
        "contents": "The fjord command-line tool wasn't found.\n[Install the CLI](https://github.com/jhtjernsmo/fjord/releases/latest) or set its path in settings.\n[Open settings](command:workbench.action.openSettings?%22fjord.cliPath%22)",
        "when": "fjord.state == noCli"
      }
    ],
    "commands": [
      { "command": "fjord.refresh", "title": "Refresh", "category": "Fjord", "icon": "$(refresh)" },
      { "command": "fjord.newTask", "title": "New Task", "category": "Fjord", "icon": "$(add)" },
      { "command": "fjord.startTask", "title": "Start Task (Check Out Branch)", "category": "Fjord", "icon": "$(git-branch)" },
      { "command": "fjord.moveTask", "title": "Move Task…", "category": "Fjord" },
      { "command": "fjord.doneTask", "title": "Mark Task as Done", "category": "Fjord", "icon": "$(check)" },
      { "command": "fjord.openPullRequest", "title": "Open Pull Request for Task", "category": "Fjord", "icon": "$(git-pull-request)" },
      { "command": "fjord.showTask", "title": "Show Task", "category": "Fjord" },
      { "command": "fjord.copyRef", "title": "Copy Task Reference", "category": "Fjord" },
      { "command": "fjord.currentTask", "title": "Current Task Actions", "category": "Fjord" }
    ],
    "menus": {
      "view/title": [
        { "command": "fjord.newTask", "when": "view == fjord.board && fjord.state == linked", "group": "navigation@1" },
        { "command": "fjord.refresh", "when": "view == fjord.board", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "fjord.startTask", "when": "view == fjord.board && viewItem =~ /^task/", "group": "inline@1" },
        { "command": "fjord.doneTask", "when": "view == fjord.board && viewItem == task", "group": "inline@2" },
        { "command": "fjord.startTask", "when": "view == fjord.board && viewItem =~ /^task/", "group": "1_work@1" },
        { "command": "fjord.openPullRequest", "when": "view == fjord.board && viewItem =~ /^task/", "group": "1_work@2" },
        { "command": "fjord.moveTask", "when": "view == fjord.board && viewItem =~ /^task/", "group": "2_move@1" },
        { "command": "fjord.doneTask", "when": "view == fjord.board && viewItem == task", "group": "2_move@2" },
        { "command": "fjord.showTask", "when": "view == fjord.board && viewItem =~ /^task/", "group": "3_info@1" },
        { "command": "fjord.copyRef", "when": "view == fjord.board && viewItem =~ /^task/", "group": "3_info@2" }
      ],
      "commandPalette": [
        { "command": "fjord.showTask", "when": "false" },
        { "command": "fjord.copyRef", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Fjord",
      "properties": {
        "fjord.cliPath": {
          "type": "string",
          "default": "fjord",
          "description": "Path to the fjord command-line tool."
        },
        "fjord.refreshSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "How often to refresh the board while the window is focused."
        },
        "fjord.showDoneTasks": {
          "type": "boolean",
          "default": false,
          "description": "Show the tasks in done columns, not just their count."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "tsc -p . && node --test out/test/",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.95.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "~5.9.0"
  }
}
